<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Speak & See</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap');
  :root {
    --bg: #0b0d0f;
    --panel: #14171a;
    --line: #23272b;
    --ink: #eef1f3;
    --ink-dim: #8b939b;
    --accent: #5ee6a0;
    --accent-dim: #2f7a54;
    --danger: #ff6b5e;
  }

* { box-sizing: border-box; }
body {
margin: 0;
background: var(--bg);
color: var(--ink);
font-family: 'Space Grotesk', sans-serif;
min-height: 100vh;
display: flex;
align-items: center;
justify-content: center;
padding: 32px 16px;
}
.app { width: 100%; max-width: 720px; }
header {
display: flex;
align-items: baseline;
justify-content: space-between;
margin-bottom: 28px;
}
h1 { font-size: 28px; font-weight: 700; margin: 0; letter-spacing: -0.01em; }
.status { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: var(--ink-dim); }
.status.live { color: var(--accent); }
.stage {
background: var(--panel);
border: 1px solid var(--line);
border-radius: 4px;
padding: 24px;
}
canvas {
width: 100%;
height: 120px;
display: block;
border-radius: 2px;
background: #0e1012;
}
.controls { display: flex; align-items: center; gap: 12px; margin-top: 20px; }
button {
font-family: 'Space Grotesk', sans-serif;
font-size: 15px;
font-weight: 500;
padding: 12px 22px;
border-radius: 3px;
border: 1px solid var(--accent);
background: transparent;
color: var(--accent);
cursor: pointer;
transition: background 0.15s, color 0.15s;
}
button:hover { background: rgba(94,230,160,0.08); }
button.recording {
border-color: var(--danger);
color: var(--danger);
background: rgba(255,107,94,0.08);
}
button:disabled { opacity: 0.35; cursor: not-allowed; }
.timer { font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: var(--ink-dim); }
.captions { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 20px; }
.captions-label { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--ink-dim); margin-bottom: 10px; }
.caption-line { font-size: 22px; line-height: 1.5; min-height: 66px; }
.caption-final { color: var(--ink); }
.caption-interim { color: var(--ink-dim); }
.empty-hint { color: var(--ink-dim); font-size: 15px; }
.accurate-section { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 20px; }
.accurate-btn { width: 100%; }
.accurate-btn.loading { opacity: 0.6; cursor: wait; }
.accurate-result { margin-top: 16px; font-size: 22px; line-height: 1.5; color: var(--ink); }
.accurate-error { margin-top: 14px; font-size: 13px; color: var(--danger); }
.grammar-section { margin-top: 16px; }
.grammar-btn { width: 100%; border-color: var(--accent-dim); color: var(--accent-dim); }
.grammar-btn:not(:disabled):hover { color: var(--accent); border-color: var(--accent); }
.grammar-result { margin-top: 16px; font-size: 22px; line-height: 1.5; color: var(--accent); }
.manual-input {
  width: 100%;
  background: #0e1012;
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: 3px;
  padding: 12px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 15px;
  resize: vertical;
}
.unsupported {
margin-top: 20px;
padding: 14px 16px;
border: 1px solid var(--danger);
border-radius: 3px;
color: var(--danger);
font-size: 14px;
display: none;
}
</style>
</head>
<body>

<div class="app">
  <header>
    <h1>Speak &amp; See</h1>
    <div class="status" id="status">idle</div>
  </header>
  <div class="stage">
    <canvas id="wave" width="1280" height="240"></canvas>
    <div class="controls">
      <button id="toggleBtn">Start speaking</button>
      <span class="timer" id="timer">00:00</span>
    </div>
    <div class="captions">
      <div class="captions-label">live captions</div>
      <div class="caption-line" id="captionLine">
        <span class="empty-hint">Your words will appear here as you speak.</span>
      </div>
    </div>
    <div class="unsupported" id="unsupported">
      Live captions need Chrome or Edge on desktop or Android — this browser doesn't support them. The waveform will still work.
    </div>

    <div class="grammar-section">
      <button id="grammarBtn" class="accurate-btn grammar-btn" disabled>Fix grammar mistakes</button>
      <div class="grammar-result" id="grammarResult"></div>
    </div>

    <div class="accurate-section">
      <div class="captions-label">type text to test (no mic needed)</div>
      <textarea id="manualInput" rows="3" class="manual-input" placeholder="Type a sentence here, e.g. My name is Jenny. I am a boy."></textarea>
      <button id="manualBtn" class="accurate-btn grammar-btn" style="margin-top:10px;">Fix grammar (typed text)</button>
      <div class="grammar-result" id="manualResult"></div>
      <div class="accurate-error" id="manualError"></div>
    </div>
  </div>
</div>
<script>
  const toggleBtn = document.getElementById('toggleBtn');
  const statusEl = document.getElementById('status');
  const timerEl = document.getElementById('timer');
  const captionLine = document.getElementById('captionLine');
  const unsupportedEl = document.getElementById('unsupported');
  const canvas = document.getElementById('wave');
  const ctx = canvas.getContext('2d');
  const accurateBtn = document.getElementById('accurateBtn');
  const accurateResult = document.getElementById('accurateResult');
  const accurateError = document.getElementById('accurateError');
  const grammarBtn = document.getElementById('grammarBtn');
  const grammarResult = document.getElementById('grammarResult');
  const manualInput = document.getElementById('manualInput');
  const manualBtn = document.getElementById('manualBtn');
  const manualResult = document.getElementById('manualResult');
  const manualError = document.getElementById('manualError');
  let audioCtx, analyser, source, stream, dataArray, rafId;
  let recognizer, recognizing = false;
  let finalText = '';
  let startTime, timerInterval;
  let mediaRecorder, recordedChunks = [];
  let lastRecordingBlob = null;
  let lastRawTranscript = '';
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SpeechRecognition) {
    unsupportedEl.style.display = 'block';
  }
  function drawIdle() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.strokeStyle = '#23272b';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(0, canvas.height / 2);
    ctx.lineTo(canvas.width, canvas.height / 2);
    ctx.stroke();
  }
  drawIdle();
  function drawFrame() {
    analyser.getByteTimeDomainData(dataArray);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.lineWidth = 2;
    ctx.strokeStyle = '#5ee6a0';
    ctx.beginPath();
    const sliceWidth = canvas.width / dataArray.length;
    let x = 0;
    for (let i = 0; i < dataArray.length; i++) {
      const v = dataArray[i] / 128.0;
      const y = (v * canvas.height) / 2;
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
      x += sliceWidth;
    }
    ctx.lineTo(canvas.width, canvas.height / 2);
    ctx.stroke();
    rafId = requestAnimationFrame(drawFrame);
  }
  function updateTimer() {
    const elapsed = Math.floor((Date.now() - startTime) / 1000);
    const m = String(Math.floor(elapsed / 60)).padStart(2, '0');
    const s = String(elapsed % 60).padStart(2, '0');
    timerEl.textContent = `${m}:${s}`;
  }
  function setupRecognizer() {
    recognizer = new SpeechRecognition();
    recognizer.continuous = true;
    recognizer.interimResults = true;
    recognizer.lang = 'en-US';
    recognizer.maxAlternatives = 1;
    recognizer.onresult = (event) => {
      let interim = '';
      for (let i = event.resultIndex; i < event.results.length; i++) {
        const transcript = event.results[i][0].transcript;
        if (event.results[i].isFinal) {
          finalText += transcript + ' ';
        } else {
          interim += transcript;
        }
      }
      captionLine.innerHTML =
        `<span class="caption-final">${finalText}</span><span class="caption-interim">${interim}</span>`;
    };
    recognizer.onerror = (e) => {
      console.warn('Speech recognition error', e.error);
    };
    recognizer.onend = () => {
      restartRecognizer();
    };
  }
  function restartRecognizer() {
    if (!recognizing) return;
    setupRecognizer();
    try {
      recognizer.start();
    } catch (e) {
      setTimeout(restartRecognizer, 150);
    }
  }
  async function start() {
    stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    source = audioCtx.createMediaStreamSource(stream);
    analyser = audioCtx.createAnalyser();
    analyser.fftSize = 2048;
    dataArray = new Uint8Array(analyser.fftSize);
    source.connect(analyser);
    drawFrame();
    recordedChunks = [];
    mediaRecorder = new MediaRecorder(stream);
    mediaRecorder.ondataavailable = (e) => {
      if (e.data.size > 0) recordedChunks.push(e.data);
    };
    mediaRecorder.start();
    finalText = '';
    captionLine.innerHTML = '<span class="caption-final"></span><span class="caption-interim"></span>';
    accurateResult.textContent = '';
    accurateError.textContent = '';
    grammarResult.textContent = '';
    grammarBtn.disabled = true;
    accurateBtn.disabled = true;
    lastRawTranscript = '';
    if (SpeechRecognition) {
      setupRecognizer();
      recognizing = true;
      recognizer.start();
    }
    startTime = Date.now();
    timerInterval = setInterval(updateTimer, 250);
    toggleBtn.textContent = 'Stop';
    toggleBtn.classList.add('recording');
    statusEl.textContent = 'live';
    statusEl.classList.add('live');
  }
  function stop() {
    if (rafId) cancelAnimationFrame(rafId);
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      mediaRecorder.onstop = () => {
        lastRecordingBlob = new Blob(recordedChunks, { type: 'audio/webm' });
        accurateBtn.disabled = !lastRecordingBlob;
      };
      mediaRecorder.stop();
    }
    if (stream) stream.getTracks().forEach(t => t.stop());
    if (audioCtx) audioCtx.close();
    recognizing = false;
    if (recognizer) recognizer.stop();
    clearInterval(timerInterval);
    drawIdle();
    toggleBtn.textContent = 'Start speaking';
    toggleBtn.classList.remove('recording');
    statusEl.textContent = 'idle';
    statusEl.classList.remove('live');
    if (finalText.trim()) {
      captionLine.innerHTML =
        '<textarea id="editCaption" class="manual-input" rows="3">' + finalText.trim() + '</textarea>';
      grammarBtn.disabled = false;
    } else {
      captionLine.innerHTML = '<span class="empty-hint">Your words will appear here as you speak.</span>';
    }
  }
  accurateBtn.addEventListener('click', async () => {
    if (!lastRecordingBlob) return;
    accurateError.textContent = '';
    accurateResult.textContent = '';
    grammarResult.textContent = '';
    grammarBtn.disabled = true;
    accurateBtn.disabled = true;
    accurateBtn.classList.add('loading');
    accurateBtn.textContent = 'Transcribing… (running on your Mac)';
    try {
      const formData = new FormData();
      formData.append('file', lastRecordingBlob, 'recording.webm');
      const response = await fetch('http://localhost:5005/transcribe', {
        method: 'POST',
        body: formData
      });
      const data = await response.json();
      if (!response.ok) {
        throw new Error(data.error || 'Request failed');
      }
      lastRawTranscript = data.text;
      accurateResult.textContent = data.text;
      grammarBtn.disabled = false;
    } catch (err) {
      accurateError.textContent = `Error: ${err.message}. Make sure backend.py is running in Terminal.`;
    } finally {
      accurateBtn.disabled = false;
      accurateBtn.classList.remove('loading');
      accurateBtn.textContent = 'Get accurate transcript';
    }
  });
  grammarBtn.addEventListener('click', async () => {
    const editBox = document.getElementById('editCaption');
    const liveText = editBox ? editBox.value.trim() : finalText.trim();
    if (liveText) lastRawTranscript = liveText;
    if (!lastRawTranscript) return;
    grammarResult.textContent = '';
    grammarBtn.disabled = true;
    grammarBtn.classList.add('loading');
    grammarBtn.textContent = 'Fixing grammar… (running on your Mac)';
    try {
      const response = await fetch('http://localhost:5005/fix-grammar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: lastRawTranscript })
      });
      const data = await response.json();
      if (!response.ok) {
        throw new Error(data.error || 'Request failed');
      }
      grammarResult.textContent = data.text;
    } catch (err) {
      accurateError.textContent = `Error: ${err.message}. Make sure backend.py is running in Terminal.`;
    } finally {
      grammarBtn.disabled = false;
      grammarBtn.classList.remove('loading');
      grammarBtn.textContent = 'Fix grammar mistakes';
    }
  });
  manualBtn.addEventListener('click', async () => {
    const text = manualInput.value.trim();
    if (!text) return;
    manualResult.textContent = '';
    manualError.textContent = '';
    manualBtn.disabled = true;
    manualBtn.textContent = 'Fixing grammar…';
    try {
      const response = await fetch('http://localhost:5005/fix-grammar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text })
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Request failed');
      manualResult.textContent = data.text;
    } catch (err) {
      manualError.textContent = `Error: ${err.message}. Make sure backend.py is running.`;
    } finally {
      manualBtn.disabled = false;
      manualBtn.textContent = 'Fix grammar (typed text)';
    }
  });
  toggleBtn.addEventListener('click', async () => {
    if (toggleBtn.classList.contains('recording')) {
      stop();
    } else {
      toggleBtn.disabled = true;
      try {
        await start();
      } catch (err) {
        alert('Could not access your microphone. Please allow microphone access and try again.');
      }
      toggleBtn.disabled = false;
    }
  });
</script>

</body>
</html>
